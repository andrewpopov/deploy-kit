{
  "name": "@andrewpopov/deploy-kit",
  "version": "0.24.1",
  "description": "Hook-driven SSH/local deploy pipeline + remote PM2 ops CLI + Cloudflare tunnel launcher",
  "author": "Andrew Popov",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewpopov/deploy-kit.git"
  },
  "bugs": {
    "url": "https://github.com/andrewpopov/deploy-kit/issues"
  },
  "homepage": "https://github.com/andrewpopov/deploy-kit#readme",
  "bin": {
    "deploy-kit": "src/cli.js"
  },
  "files": [
    "src",
    "!src/__tests__",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:types": "tsc --noEmit -p tsconfig.types.json",
    "verify": "npm run lint && npm run verify:types && npm test && npm run verify:pack && npm run verify:bins && npm run release:check",
    "release:note": "release-kit note",
    "release:notes": "release-kit notes",
    "release:bump": "release-kit bump",
    "release:cut": "release-kit cut",
    "release:check": "release-kit check",
    "release:hygiene": "release-kit hygiene",
    "verify:bins": "release-kit verify-bins",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@andrewpopov/alert-kit": "github:andrewpopov/alert-kit#v0.6.1",
    "@andrewpopov/release-kit": "github:andrewpopov/release-kit#v0.3.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "deployment",
    "ssh",
    "rollback",
    "pm2",
    "release-management",
    "cli"
  ]
}
