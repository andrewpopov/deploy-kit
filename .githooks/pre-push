#!/usr/bin/env sh
#
# Local pre-push gate — this repo's CI, run on your own machine.
#
# GitHub Actions is disabled across this fleet, so nothing runs server-side.
# For a PACKAGE that matters more than it does for an app, not less: a broken
# push here is consumed by every app pinning this repo, and the failure surfaces
# in their deploy rather than here, where the cause is.
#
# Order is cheapest-first so you fail fast.
#
# Escape hatch: `git push --no-verify`. Use it when you mean to — pushing a WIP
# branch for review, or a docs-only branch — not to get past a red check. A
# guard you routinely bypass is a guard you do not have.
#
# Wired by the `prepare` script (`git config core.hooksPath .githooks`), so a
# fresh clone gets it on install. If it is not firing, run `npm install` and
# check `git config core.hooksPath` resolves to a directory that exists.
set -e

# Git exports its repository-local variables to hooks. From a WORKTREE it sets
# GIT_DIR, so any `git -C <somewhere>` in a child process silently operates on
# THIS repo instead of <somewhere> -- `-C` changes directory, but GIT_DIR still
# wins the repository lookup. That is not hypothetical: a fixture running
# `git config core.bare true` wrote to the live repo instead of its fixture.
# It does NOT reproduce from the primary checkout, only from a worktree, which
# is where all implementation work in this fleet happens.
#
# Use git's OWN list rather than a hand-kept one: a partial list already missed
# GIT_CONFIG, which is the direct mutation hazard. This cannot drift as git
# adds variables.
for v in $(git rev-parse --local-env-vars) GIT_QUARANTINE_PATH; do unset "$v"; done

# A push that only deletes refs has nothing to verify.
only_deletes=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) only_deletes=0 ;;
  esac
done
if [ "$only_deletes" = "1" ]; then
  exit 0
fi

step() { printf '\n\033[36m▸ pre-push: %s\033[0m\n' "$1"; }
fail() {
  printf '\n\033[31m✗ pre-push: %s FAILED — push blocked.\033[0m\n' "$1"
  shift
  for line in "$@"; do printf '  %s\n' "$line"; done
  exit 1
}

# Reconcile node_modules with the lockfile BEFORE verifying anything. Most of
# the drift found across this fleet was not a bad bump — it was a tree that had
# simply never been installed after pulling someone else's.
lock_state() { git status --porcelain -- '*package-lock.json' '*pnpm-lock.yaml' 2>/dev/null; }
lock_before="$(lock_state)"
step 'install'
npm install --prefer-offline || fail 'install'

# If installing MOVED the lockfile, the committed one was stale — everything
# below would then verify a tree that is not the one being pushed.
if [ "$(lock_state)" != "$lock_before" ]; then
  lock_state
  fail 'lockfile changed during install' \
    'The committed lockfile did not match the manifest, so what you just' \
    'tested is not what you are pushing. Review and commit the lockfile.'
fi

# A `github:owner/repo#tag` pin does NOT re-resolve when only the tag moves —
# npm keys the lockfile on the resolved commit, so a bumped pin installs clean
# while leaving the old code on disk. This reads the installed version off disk
# and compares it to the pin. It is the first real check for exactly that
# reason: everything below would otherwise verify the wrong code.
step 'verify-pins'
node ./src/cli.js verify-pins || fail 'verify-pins' \
  'A pinned dependency on disk does not match its manifest pin.' \
  'Install it explicitly (npm install <name>@github:owner/repo#<tag>) and' \
  'confirm by reading node_modules/<name>/package.json — not the manifest.'

# lint + types + tests + pack + bins + release:check.
step 'verify'
npm run verify || fail 'verify'

printf '\n\033[32m✓ pre-push gate passed.\033[0m\n'
